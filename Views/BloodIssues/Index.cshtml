@model List<BloodBankManagementSystem.Models.BloodIssue>

@{
    ViewData["Title"] = "Blood Issues";
}

<div class="page-heading d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Blood Issues</h1>
        <p class="text-muted mb-0">Manage blood issued to patients.</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">Issue Blood</a>
</div>

<div class="data-card card shadow-sm border-0">
    <div class="card-body">
        <div class="table-responsive" role="region" tabindex="0" aria-label="Blood issue records">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">ID</th>
                        <th scope="col">Patient Name</th>
                        <th scope="col">Blood Group</th>
                        <th scope="col">Hospital</th>
                        <th scope="col">Contact</th>
                        <th scope="col">Units</th>
                        <th scope="col">Issue Date</th>
                        <th scope="col">Status</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr class="empty-state-row">
                            <td colspan="9" class="empty-state-cell">
                                <i class="bi bi-inbox" aria-hidden="true"></i>
                                <span>No blood issues have been recorded yet.</span>
                                <a asp-action="Create" class="btn btn-sm btn-primary">Issue the first unit</a>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var issue in Model)
                        {
                            <tr>
                                <td>@issue.BloodIssueId</td>
                                <td>@issue.PatientName</td>
                                <td><span class="badge bg-danger">@issue.BloodGroup</span></td>
                                <td>@issue.HospitalName</td>
                                <td>@issue.ContactNumber</td>
                                <td>@issue.UnitsIssued</td>
                                <td>@issue.IssueDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (issue.Status == "Issued")
                                    {
                                        <span class="badge bg-success">Issued</span>
                                    }
                                    else if (issue.Status == "Cancelled")
                                    {
                                        <span class="badge bg-secondary">Cancelled</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">@issue.Status</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@issue.BloodIssueId" class="btn btn-sm btn-outline-primary">Edit</a>
                                    <form asp-action="Delete" asp-route-id="@issue.BloodIssueId" method="post" class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to delete this blood issue? This action cannot be undone.');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
