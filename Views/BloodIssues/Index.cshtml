@model List<BloodBankManagementSystem.Models.BloodIssue>

@{
    ViewData["Title"] = "Blood Issues";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h1 class="mb-1">Blood Issues</h1>
        <p class="text-muted mb-0">
            Manage blood issued to patients.
        </p>
    </div>

    <a asp-controller="BloodIssues"
       asp-action="Create"
       class="btn btn-primary">
        + Issue Blood
    </a>

</div>


<div class="card shadow-sm border-0">

    <div class="card-body">

        @if (Model.Count == 0)
        {
            <div class="text-center py-5">

                <h4 class="text-muted">
                    No blood issues found.
                </h4>

                <p class="text-muted">
                    No blood has been issued yet.
                </p>

                <a asp-action="Create"
                   class="btn btn-primary">
                    Issue Blood
                </a>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-dark">

                        <tr>
                            <th>ID</th>
                            <th>Patient Name</th>
                            <th>Blood Group</th>
                            <th>Hospital</th>
                            <th>Contact</th>
                            <th>Units</th>
                            <th>Issue Date</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var issue in Model)
                        {
                            <tr>

                                <td>
                                    @issue.BloodIssueId
                                </td>

                                <td>
                                    @issue.PatientName
                                </td>

                                <td>
                                    <span class="badge bg-danger">
                                        @issue.BloodGroup
                                    </span>
                                </td>

                                <td>
                                    @issue.HospitalName
                                </td>

                                <td>
                                    @issue.ContactNumber
                                </td>

                                <td>
                                    @issue.UnitsIssued
                                </td>

                                <td>
                                    @issue.IssueDate.ToString("dd-MM-yyyy")
                                </td>

                                <td>

                                    @if (issue.Status == "Issued")
                                    {
                                        <span class="badge bg-success">
                                            Issued
                                        </span>
                                    }
                                    else if (issue.Status == "Cancelled")
                                    {
                                        <span class="badge bg-secondary">
                                            Cancelled
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            @issue.Status
                                        </span>
                                    }

                                </td>

                                <td>

                                    <a asp-action="Edit"
                                       asp-route-id="@issue.BloodIssueId"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@issue.BloodIssueId"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to delete this blood issue?');">

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">
                                            Delete
                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>