@model List<BloodBankManagementSystem.Models.BloodRequest>

@{
    ViewData["Title"] = "Blood Requests";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h1>Blood Requests</h1>
        <p class="text-muted mb-0">
            Manage patient blood requests and their status.
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">
        Add Blood Request
    </a>

</div>

<div class="card shadow-sm">

    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-bordered table-hover align-middle">

                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Patient Name</th>
                        <th>Blood Group</th>
                        <th>Hospital</th>
                        <th>Contact</th>
                        <th>Units Required</th>
                        <th>Request Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var request in Model)
                    {
                        <tr>

                            <td>
                                @request.BloodRequestId
                            </td>

                            <td>
                                @request.PatientName
                            </td>

                            <td>
                                <span class="badge bg-danger">
                                    @request.BloodGroup
                                </span>
                            </td>

                            <td>
                                @request.HospitalName
                            </td>

                            <td>
                                @request.ContactNumber
                            </td>

                            <td>
                                @request.UnitsRequired
                            </td>

                            <td>
                                @request.RequestDate.ToShortDateString()
                            </td>

                            <td>

                                @if (request.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pending
                                    </span>
                                }
                                else if (request.Status == "Approved")
                                {
                                    <span class="badge bg-success">
                                        Approved
                                    </span>
                                }
                                else if (request.Status == "Fulfilled")
                                {
                                    <span class="badge bg-primary">
                                        Fulfilled
                                    </span>
                                }
                                else if (request.Status == "Rejected")
                                {
                                    <span class="badge bg-danger">
                                        Rejected
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @request.Status
                                    </span>
                                }

                            </td>

                            <td>

                                <a asp-action="Edit"
                                   asp-route-id="@request.BloodRequestId"
                                   class="btn btn-sm btn-warning">
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@request.BloodRequestId"
                                   class="btn btn-sm btn-danger">
                                    Delete
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>