@model BloodBankManagementSystem.Models.BloodRequest

@{
    ViewData["Title"] = "Add Blood Request";
}

<div class="mb-4">
    <h1>Add Blood Request</h1>
    <p class="text-muted">Enter the blood request information below.</p>
</div>

<div class="card shadow-sm">
    <div class="card-body">

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <!-- Patient Name -->
            <div class="mb-3">
                <label asp-for="PatientName" class="form-label">
                    Patient Name
                </label>

                <input asp-for="PatientName"
                       class="form-control" />

                <span asp-validation-for="PatientName"
                      class="text-danger">
                </span>
            </div>

            <!-- Blood Group -->
            <div class="mb-3">
                <label asp-for="BloodGroup" class="form-label">
                    Blood Group
                </label>

                <select asp-for="BloodGroup"
                        class="form-select">

                    <option value="">-- Select Blood Group --</option>
                    <option value="A+">A+</option>
                    <option value="A-">A-</option>
                    <option value="B+">B+</option>
                    <option value="B-">B-</option>
                    <option value="AB+">AB+</option>
                    <option value="AB-">AB-</option>
                    <option value="O+">O+</option>
                    <option value="O-">O-</option>

                </select>

                <span asp-validation-for="BloodGroup"
                      class="text-danger">
                </span>
            </div>

            <!-- Hospital Name -->
            <div class="mb-3">
                <label asp-for="HospitalName" class="form-label">
                    Hospital Name
                </label>

                <input asp-for="HospitalName"
                       class="form-control" />

                <span asp-validation-for="HospitalName"
                      class="text-danger">
                </span>
            </div>

            <!-- Contact Number -->
            <div class="mb-3">
                <label asp-for="ContactNumber" class="form-label">
                    Contact Number
                </label>

                <input asp-for="ContactNumber"
                       class="form-control"
                       type="tel"
                       inputmode="numeric"
                       maxlength="10"
                       minlength="10"
                       pattern="[0-9]{10}"
                       placeholder="Enter 10-digit contact number"
                       oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10);" />

                <span asp-validation-for="ContactNumber"
                      class="text-danger">
                </span>

                <div class="form-text">
                    Contact number must contain exactly 10 digits.
                </div>
            </div>

            <!-- Units Required -->
            <div class="mb-3">
                <label asp-for="UnitsRequired" class="form-label">
                    Units Required
                </label>

                <input asp-for="UnitsRequired"
                       type="number"
                       class="form-control" />

                <span asp-validation-for="UnitsRequired"
                      class="text-danger">
                </span>
            </div>

            <!-- Request Date -->
            <div class="mb-3">
                <label asp-for="RequestDate" class="form-label">
                    Request Date
                </label>

                <input asp-for="RequestDate"
                       type="date"
                       class="form-control" />

                <span asp-validation-for="RequestDate"
                      class="text-danger">
                </span>
            </div>

            <!-- Status -->
            <div class="mb-3">
                <label asp-for="Status" class="form-label">
                    Status
                </label>

                <select asp-for="Status"
                        class="form-select">

                    <option value="">-- Select Status --</option>
                    <option value="Pending">Pending</option>
                    <option value="Approved">Approved</option>
                    <option value="Fulfilled">Fulfilled</option>
                    <option value="Rejected">Rejected</option>

                </select>

                <span asp-validation-for="Status"
                      class="text-danger">
                </span>
            </div>

            <!-- Buttons -->
            <button type="submit"
                    class="btn btn-primary">
                Save Request
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}