@model List<BloodBankManagementSystem.Models.Donor>

@{
    ViewData["Title"] = "Donors";
}

<div class="page-heading d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Donors</h1>
        <p class="text-muted mb-0">
            Manage registered blood donors.
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">
        Add New Donor
    </a>
</div>

<div class="data-card card shadow-sm border-0">

    <div class="card-body">

        <div class="table-responsive" role="region" tabindex="0" aria-label="Donor records">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th scope="col">ID</th>
                        <th scope="col">Name</th>
                        <th scope="col">Blood Group</th>
                        <th scope="col">Phone</th>
                        <th scope="col">Email</th>
                        <th scope="col">Address</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Count == 0)
                    {
                        <tr class="empty-state-row">
                            <td colspan="7" class="empty-state-cell">
                                <i class="bi bi-inbox" aria-hidden="true"></i>
                                <span>No donors have been registered yet.</span>
                                <a asp-action="Create" class="btn btn-sm btn-primary">Add the first donor</a>
                            </td>
                        </tr>
                    }
                    else
                    {
                    @foreach (var donor in Model)
                    {
                        <tr>

                            <td>
                                @donor.DonorId
                            </td>

                            <td>
                                @donor.Name
                            </td>

                            <td>
                                <span class="badge bg-danger">
                                    @donor.BloodGroup
                                </span>
                            </td>

                            <td>
                                @donor.Phone
                            </td>

                            <td>
                                @donor.Email
                            </td>

                            <td>
                                @donor.Address
                            </td>

                            <td>
                                <a asp-action="Edit" asp-route-id="@donor.DonorId" class="btn btn-sm btn-outline-primary">Edit</a>

                                <form asp-action="Delete" asp-route-id="@donor.DonorId" method="post" class="d-inline"
                                      onsubmit="return confirm('Are you sure you want to delete this donor? This action cannot be undone.');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>

                        </tr>
                    }

                    }

                </tbody>

            </table>

        </div>

    </div>

</div>