@model BloodBankManagementSystem.Models.BloodUnit

@{
    ViewData["Title"] = "Add Blood Unit";
}

<div class="mb-4">
    <h1>Add Blood Unit</h1>
    <p class="text-muted">Enter the blood unit information below.</p>
</div>

<div class="card shadow-sm">
    <div class="card-body">

        <form asp-action="Create" method="post" id="bloodUnitForm">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <!-- Blood Group -->
            <div class="mb-3">
                <label asp-for="BloodGroup" class="form-label">
                    Blood Group
                </label>

                <select asp-for="BloodGroup"
                        class="form-select">

                    <option value="">-- Select Blood Group --</option>
                    <option value="A+">A+</option>
                    <option value="A-">A-</option>
                    <option value="B+">B+</option>
                    <option value="B-">B-</option>
                    <option value="AB+">AB+</option>
                    <option value="AB-">AB-</option>
                    <option value="O+">O+</option>
                    <option value="O-">O-</option>

                </select>

                <span asp-validation-for="BloodGroup"
                      class="text-danger">
                </span>
            </div>

            <!-- Component Type -->
            <div class="mb-3">
                <label asp-for="ComponentType" class="form-label">
                    Component Type
                </label>

                <select asp-for="ComponentType"
                        class="form-select">

                    <option value="">-- Select Component Type --</option>
                    <option value="Whole Blood">Whole Blood</option>
                    <option value="Red Blood Cells">Red Blood Cells</option>
                    <option value="Platelets">Platelets</option>
                    <option value="Plasma">Plasma</option>

                </select>

                <span asp-validation-for="ComponentType"
                      class="text-danger">
                </span>
            </div>

            <!-- Collection Date -->
            <div class="mb-3">
                <label asp-for="CollectionDate" class="form-label">
                    Collection Date
                </label>

                <input asp-for="CollectionDate"
                       type="date"
                       class="form-control"
                       id="collectionDate" />

                <span asp-validation-for="CollectionDate"
                      class="text-danger">
                </span>
            </div>

            <!-- Expiry Date -->
            <div class="mb-3">
                <label asp-for="ExpiryDate" class="form-label">
                    Expiry Date
                </label>

                <input asp-for="ExpiryDate"
                       type="date"
                       class="form-control"
                       id="expiryDate" />

                <span asp-validation-for="ExpiryDate"
                      class="text-danger">
                </span>

                <div class="form-text">
                    Expiry date must be after the collection date.
                </div>

                <div id="dateError"
                     class="text-danger mt-1"
                     style="display: none;">
                    Expiry date must be after collection date.
                </div>
            </div>

            <!-- Status -->
            <div class="mb-3">
                <label asp-for="Status" class="form-label">
                    Status
                </label>

                <select asp-for="Status"
                        class="form-select">

                    <option value="">-- Select Status --</option>
                    <option value="Available">Available</option>
                    <option value="Used">Used</option>
                    <option value="Expired">Expired</option>

                </select>

                <span asp-validation-for="Status"
                      class="text-danger">
                </span>
            </div>

            <!-- Buttons -->
            <button type="submit"
                    class="btn btn-primary">
                Save Blood Unit
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const collectionDate = document.getElementById("collectionDate");
        const expiryDate = document.getElementById("expiryDate");
        const dateError = document.getElementById("dateError");
        const form = document.getElementById("bloodUnitForm");

        function validateDates() {

            if (collectionDate.value) {

                const collection = new Date(collectionDate.value);

                collection.setDate(collection.getDate() + 1);

                const minimumExpiryDate =
                    collection.toISOString().split("T")[0];

                expiryDate.min = minimumExpiryDate;
            }
            else {
                expiryDate.removeAttribute("min");
            }

            if (collectionDate.value &&
                expiryDate.value &&
                expiryDate.value <= collectionDate.value) {

                dateError.style.display = "block";

                expiryDate.setCustomValidity(
                    "Expiry date must be after collection date."
                );

            }
            else {

                dateError.style.display = "none";

                expiryDate.setCustomValidity("");
            }
        }

        collectionDate.addEventListener("change", function () {

            validateDates();

            if (expiryDate.value &&
                expiryDate.value <= collectionDate.value) {

                expiryDate.value = "";
            }
        });

        expiryDate.addEventListener("change", function () {

            validateDates();
        });

        form.addEventListener("submit", function (event) {

            validateDates();

            if (!form.checkValidity()) {

                event.preventDefault();

                form.reportValidity();
            }
        });

        validateDates();
    </script>
}