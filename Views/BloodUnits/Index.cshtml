@model List<BloodBankManagementSystem.Models.BloodUnit>

@{
    ViewData["Title"] = "Blood Units";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h1>Blood Units</h1>
        <p class="text-muted mb-0">
            Manage available and stored blood units.
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">
        Add Blood Unit
    </a>

</div>

<div class="card shadow-sm">

    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-bordered table-hover align-middle">

                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Blood Group</th>
                        <th>Collection Date</th>
                        <th>Expiry Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var bloodUnit in Model)
                    {
                        <tr>

                            <td>
                                @bloodUnit.BloodUnitId
                            </td>

                            <td>
                                <span class="badge bg-danger">
                                    @bloodUnit.BloodGroup
                                </span>
                            </td>

                            <td>
                                @bloodUnit.CollectionDate.ToShortDateString()
                            </td>

                            <td>
                                @bloodUnit.ExpiryDate.ToShortDateString()
                            </td>

                            <td>

                                @if (bloodUnit.Status == "Available")
                                {
                                    <span class="badge bg-success">
                                        Available
                                    </span>
                                }
                                else if (bloodUnit.Status == "Used")
                                {
                                    <span class="badge bg-secondary">
                                        Used
                                    </span>
                                }
                                else if (bloodUnit.Status == "Expired")
                                {
                                    <span class="badge bg-danger">
                                        Expired
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-dark">
                                        @bloodUnit.Status
                                    </span>
                                }

                            </td>

                            <td>

                                <a asp-action="Edit"
                                   asp-route-id="@bloodUnit.BloodUnitId"
                                   class="btn btn-sm btn-warning">
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@bloodUnit.BloodUnitId"
                                   class="btn btn-sm btn-danger">
                                    Delete
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>