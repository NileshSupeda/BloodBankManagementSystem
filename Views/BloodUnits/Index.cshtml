@model List<BloodBankManagementSystem.Models.BloodUnit>

@{
    ViewData["Title"] = "Blood Units";
}

<div class="page-heading d-flex justify-content-between align-items-center mb-4">

    <div>
        <h1>Blood Units</h1>
        <p class="text-muted mb-0">
            Manage available and stored blood units.
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">
        Add Blood Unit
    </a>

</div>

<div class="data-card card shadow-sm border-0">

    <div class="card-body">

        <div class="table-responsive" role="region" tabindex="0" aria-label="Blood unit records">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th scope="col">ID</th>
                        <th scope="col">Blood Group</th>
                        <th scope="col">Component Type</th>
                        <th scope="col">Collection Date</th>
                        <th scope="col">Expiry Date</th>
                        <th scope="col">Status</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Count == 0)
                    {
                        <tr class="empty-state-row">
                            <td colspan="7" class="empty-state-cell">
                                <i class="bi bi-inbox" aria-hidden="true"></i>
                                <span>No blood units have been added yet.</span>
                                <a asp-action="Create" class="btn btn-sm btn-primary">Add the first blood unit</a>
                            </td>
                        </tr>
                    }
                    else
                    {
                    @foreach (var bloodUnit in Model)
                    {
                        <tr>

                            <td>
                                @bloodUnit.BloodUnitId
                            </td>

                            <td>
                                <span class="badge bg-danger">
                                    @bloodUnit.BloodGroup
                                </span>
                            </td>

                            <td>
                                @bloodUnit.ComponentType
                            </td>

                            <td>
                                @bloodUnit.CollectionDate.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @bloodUnit.ExpiryDate.ToString("dd MMM yyyy")
                            </td>

                            <td>

                                @if (bloodUnit.Status == "Available")
                                {
                                    <span class="badge bg-success">
                                        Available
                                    </span>
                                }
                                else if (bloodUnit.Status == "Issued" || bloodUnit.Status == "Used")
                                {
                                    <span class="badge bg-secondary">
                                        @bloodUnit.Status
                                    </span>
                                }
                                else if (bloodUnit.Status == "Expired")
                                {
                                    <span class="badge bg-danger">
                                        Expired
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-dark">
                                        @bloodUnit.Status
                                    </span>
                                }

                            </td>

                            <td>

                                <a asp-action="Edit" asp-route-id="@bloodUnit.BloodUnitId" class="btn btn-sm btn-outline-primary">Edit</a>

                                <form asp-action="Delete" asp-route-id="@bloodUnit.BloodUnitId" method="post" class="d-inline"
                                      onsubmit="return confirm('Are you sure you want to delete this blood unit? This action cannot be undone.');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>

                            </td>

                        </tr>
                    }

                    }

                </tbody>

            </table>

        </div>

    </div>

</div>